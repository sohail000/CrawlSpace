# Copy this file to .env and fill in ONE key. With no key, spiders run in heuristic (keyword) mode.
# If both are set, Gemma (GEMINI_API_KEY) wins unless CRAWL_PROVIDER says otherwise.

# Gemma 4 via the Gemini API (Google AI Studio key)
GEMINI_API_KEY=
# Claude via the Anthropic API
# ANTHROPIC_API_KEY=

# Optional: force a provider: gemini | claude | heuristic
# CRAWL_PROVIDER=gemini

# Optional: models. Gemma defaults: reader gemma-4-26b-a4b-it (fast MoE), weaver gemma-4-31b-it.
# When one Gemma model is overloaded (503/500/429) the other is tried automatically.
# Claude default for both: claude-opus-5-5.
# CRAWL_READER_MODEL=gemma-4-26b-a4b-it
# CRAWL_WEAVER_MODEL=gemma-4-31b-it

# Optional: max Gemma calls in flight at once (free tier rate-limits per minute)
# GEMINI_CONCURRENCY=2

# Optional: how much page text each spider reads (chars). Default 18000 for Gemma, 60000 for Claude.
# CRAWL_READ_CHARS=18000

# Optional politeness tuning (milliseconds)
# CRAWL_PACE_MS=1200        # rest between pages, per spider
# CRAWL_HOST_GAP_MS=1500    # minimum gap between requests to the same host
# PORT=4321

# Optional: print raw model JSON to the server console
# CRAWL_DEBUG=1
